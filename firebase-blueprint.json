{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "Referencia de material audiovisual en el inventario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "unit": { "type": "string" },
        "hasSerialNumbers": { "type": "boolean" },
        "totalQuantity": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "reservedQuantity": { "type": "number" },
        "outQuantity": { "type": "number" },
        "damagedQuantity": { "type": "number" },
        "defaultLocationId": { "type": "string" },
        "defaultLocationName": { "type": "string" },
        "supplier": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "rentalPrice": { "type": "number" },
        "acquisitionDate": { "type": "string" },
        "status": { "type": "string" },
        "minStock": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "category", "totalQuantity", "status"]
    },
    "ItemUnit": {
      "title": "ItemUnit",
      "description": "Unidad física individual con número de serie o código QR",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemCode": { "type": "string" },
        "serialNumber": { "type": "string" },
        "qrCode": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "currentEventId": { "type": "string" },
        "currentEventName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "itemId", "itemCode", "serialNumber", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Categoría de material de sonido, iluminación, vídeo y rigging",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "itemCount": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Location": {
      "title": "Location",
      "description": "Ubicación en almacén o nave técnica",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "warehouse": { "type": "string" },
        "zone": { "type": "string" },
        "description": { "type": "string" },
        "isRepairZone": { "type": "boolean" }
      },
      "required": ["id", "warehouse", "zone"]
    },
    "Event": {
      "title": "Event",
      "description": "Evento, festival, concierto o alquiler de material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "location": { "type": "string" },
        "dispatchDate": { "type": "string" },
        "eventDate": { "type": "string" },
        "returnDate": { "type": "string" },
        "manager": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "dispatchDate", "returnDate", "status"]
    },
    "EventItem": {
      "title": "EventItem",
      "description": "Línea de material asignada o reservada para un evento",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "itemCode": { "type": "string" },
        "quantityRequested": { "type": "number" },
        "quantityDispatched": { "type": "number" },
        "quantityReturned": { "type": "number" },
        "quantityDamaged": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "eventId", "itemId", "quantityRequested", "status"]
    },
    "Movement": {
      "title": "Movement",
      "description": "Registro inmutable de trazabilidad de movimiento de inventario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "itemCode": { "type": "string" },
        "quantity": { "type": "number" },
        "sourceLocation": { "type": "string" },
        "targetLocation": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "eventId": { "type": "string" },
        "eventName": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "referenceCode": { "type": "string" }
      },
      "required": ["id", "timestamp", "type", "itemId", "quantity", "userId"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Incidencia de equipo averiado o en reparación técnica",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "unitId": { "type": "string" },
        "serialNumber": { "type": "string" },
        "detectionDate": { "type": "string" },
        "reportedBy": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "technician": { "type": "string" },
        "technicalService": { "type": "string" },
        "estimatedCost": { "type": "number" },
        "appliedSolution": { "type": "string" },
        "sentToRepairDate": { "type": "string" },
        "returnedDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "itemId", "priority", "status", "description"]
    },
    "Client": {
      "title": "Client",
      "description": "Cliente o productora contratante de eventos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Proveedor o fabricante de equipos y consumibles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "suppliedCategories": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Entrada y compra de material con recepción",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "date": { "type": "string" },
        "totalAmount": { "type": "number" },
        "targetLocation": { "type": "string" },
        "responsibleUser": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "supplierName", "date"]
    },
    "InventorySession": {
      "title": "InventorySession",
      "description": "Sesión de recuento físico y regularización de almacén",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "warehouse": { "type": "string" },
        "status": { "type": "string" },
        "startedBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "startDate": { "type": "string" },
        "completionDate": { "type": "string" }
      },
      "required": ["id", "code", "warehouse", "status", "startedBy", "startDate"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil y rol de usuario del sistema con autenticación por usuario y contraseña",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "warehouse_manager", "technician", "pending"] },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "provider": { "type": "string", "maxLength": 32 },
        "avatar": { "type": "string", "maxLength": 500 },
        "assignedBy": { "type": "string", "maxLength": 120 },
        "lastLogin": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "name", "role", "status", "createdAt"]
    },
    "EquipmentKit": {
      "title": "EquipmentKit",
      "description": "QR conjunto / carro / rack con múltiples equipos agrupados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "section": { "type": "string" },
        "qrCode": { "type": "string" },
        "locationName": { "type": "string" },
        "rentalPrice": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "qrCode", "status"]
    },
    "CableBox": {
      "title": "CableBox",
      "description": "Caja de cables con QR conjunto y descuento por rotura o pérdida",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "cableType": { "type": "string" },
        "qrCode": { "type": "string" },
        "initialQuantity": { "type": "number" },
        "currentQuantity": { "type": "number" },
        "brokenCount": { "type": "number" },
        "lostCount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "qrCode", "initialQuantity", "currentQuantity"]
    },
    "ConsumableItem": {
      "title": "ConsumableItem",
      "description": "Consumible de almacén con QR y aviso automático de compra cuando baja al mínimo (ej. líquido de humo, cinta gaffer, pilas)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "qrCode": { "type": "string" },
        "currentQuantity": { "type": "number" },
        "minStock": { "type": "number" },
        "recommendedOrderQty": { "type": "number" },
        "supplier": { "type": "string" },
        "locationName": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "qrCode", "currentQuantity", "minStock"]
    },
    "DispatchNote": {
      "title": "DispatchNote",
      "description": "Albarán de salida y picking de material para eventos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "eventId": { "type": "string" },
        "eventName": { "type": "string" },
        "clientName": { "type": "string" },
        "preparedBy": { "type": "string" },
        "authorizedBy": { "type": "string" },
        "dispatchDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "eventId", "status"]
    },
    "ReturnNote": {
      "title": "ReturnNote",
      "description": "Albarán de devolución y revisión técnica de retorno de material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "eventId": { "type": "string" },
        "eventCode": { "type": "string" },
        "eventName": { "type": "string" },
        "receivedBy": { "type": "string" },
        "returnDate": { "type": "string" },
        "hasIncidents": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "eventId", "receivedBy", "returnDate"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Contrato comercial y reserva del 10% (acceso exclusivo Administrador Jefe)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "eventId": { "type": "string" },
        "eventName": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "depositAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "eventName", "totalAmount", "status"]
    },
    "ScannerBridge": {
      "title": "ScannerBridge",
      "description": "Canal privado en tiempo real por usuario para vincular el escáner QR del móvil con la sesión abierta en el PC",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "lastCode": { "type": "string", "maxLength": 500 },
        "scanId": { "type": "string", "maxLength": 128 },
        "scannedAt": { "type": "number" },
        "senderDeviceId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
        "mobileActiveAt": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "senderDeviceId", "updatedAt"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "Colección de referencias de catálogo y stock global"
    },
    "/itemUnits/{unitId}": {
      "schema": { "$ref": "#/entities/ItemUnit" },
      "description": "Unidades físicas individuales con número de serie"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Colección de categorías configurables de sonido e iluminación"
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "Almacenes y ubicaciones de almacenamiento"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Eventos y reservas de producción"
    },
    "/eventItems/{eventItemId}": {
      "schema": { "$ref": "#/entities/EventItem" },
      "description": "Líneas de material solicitadas por evento"
    },
    "/movements/{movementId}": {
      "schema": { "$ref": "#/entities/Movement" },
      "description": "Historial inmutable de movimientos y auditoría"
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Averías y partes de servicio técnico/mantenimiento"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Fichero de clientes y productoras"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Fichero de proveedores técnicos"
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Albaranes y compras de material"
    },
    "/inventorySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/InventorySession" },
      "description": "Sesiones de auditoría de inventario físico"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Usuarios del sistema con roles y permisos"
    },
    "/equipmentKits/{kitId}": {
      "schema": { "$ref": "#/entities/EquipmentKit" },
      "description": "QR conjuntos de carros, racks y packs de equipos"
    },
    "/cableBoxes/{boxId}": {
      "schema": { "$ref": "#/entities/CableBox" },
      "description": "Cajas de cables con QR conjunto y control de roturas/pérdidas"
    },
    "/consumables/{consumableId}": {
      "schema": { "$ref": "#/entities/ConsumableItem" },
      "description": "Consumibles con QR y control automático de compra (líquido de humo, cintas, pilas)"
    },
    "/dispatches/{dispatchId}": {
      "schema": { "$ref": "#/entities/DispatchNote" },
      "description": "Albaranes de salida de material"
    },
    "/returns/{returnId}": {
      "schema": { "$ref": "#/entities/ReturnNote" },
      "description": "Albaranes de devolución de material"
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/Contract" },
      "description": "Contratos comerciales y reservas del 10% (solo Administrador Jefe)"
    },
    "/scanner_bridge/{userId}": {
      "schema": { "$ref": "#/entities/ScannerBridge" },
      "description": "Puente en tiempo real privado por usuario entre la cámara remota del móvil y el PC"
    }
  }
}
